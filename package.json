{
  "name": "pageforge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/*",
    "core/*"
  ],
  "scripts": {
    "dev:web": "concurrently --kill-others \"npm run dev -w apps/web -- --port 3001\" \"node scripts/library-server.cjs --dev\"",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:desktop\"",
    "build:web": "npm run build -w apps/web",
    "build:desktop": "npm run build -w apps/desktop",
    "build:all": "npm run build:web && npm run build:desktop",
    "test:web": "npm run build:web && node apps/web/tests/workflow.cjs && node apps/web/tests/folder-workflow.cjs",
    "start:web": "node scripts/library-server.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
